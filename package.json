{
  "name": "cashinstinct-site-audit",
  "private": true,
  "type": "module",
  "scripts": {
    "test:regression": "node --test tests/regression/*.test.mjs",
    "audit:quick": "npm run test:regression && node tests/quick/audit.mjs",
    "audit:maintainability": "node tests/maintainability/audit.mjs",
    "audit:full": "playwright test",
    "audit:all": "node tests/run-all.mjs",
    "audit:full:ui": "playwright test --ui",
    "serve:test": "http-server . -p 4173 -c-1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "acorn": "^8.15.0",
    "cheerio": "^1.1.2",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.2.5",
    "html-validate": "^10.10.0",
    "http-server": "^14.1.1",
    "image-size": "^2.0.2",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.4"
  }
}
